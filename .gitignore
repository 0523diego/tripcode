.DS_Store
# Personal booking details stay out of public repos by default
trips/*/bookings.md
trips/*/export/
trips/*/tickets/
trips/*/purchase/
# Pictures pasted into the AI panel (screenshots can show booking details)
trips/*/attachments/
# Photos on itinerary items (your own pictures, and other people's copyrighted ones saved from official pages)
trips/*/photos/
# Flight price snapshots (tripcode flights --save): personal search history
trips/*/prices/
# The food guide holds the travellers' taste (what they avoid, budget, kids): personal, kept out of git by default
trips/*/food.json
trips/*/.notion.json
# Deleted trips are moved here, not erased (see the trip-delete endpoint)
.tripcode-trash/
